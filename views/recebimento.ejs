<!-- views/recebimento.ejs -->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <title>Controle de Recebimento</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div class="container mx-auto px-6 py-12">
        <a href="/lobby" class="text-indigo-600">&larr; Voltar ao Lobby</a>
        <h1 class="text-4xl font-bold mb-8">Controle de Recebimento</h1>
        <div class="bg-white p-8 rounded shadow-md max-w-2xl mx-auto">
            <form id="recebimentoForm">
                <div class="space-y-6">
                    <div>
                        <label for="fornecedor" class="block font-medium">Fornecedor</label>
                        <select id="fornecedor" name="fornecedorCnpj" required class="mt-1 w-full p-2 border rounded"></select>
                    </div>
                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <label for="berco" class="block font-medium">Berço</label>
                            <select id="berco" name="bercoId" required class="mt-1 w-full p-2 border rounded"></select>
                        </div>
                        <div>
                            <label for="prateleira" class="block font-medium">Prateleira</label>
                            <select id="prateleira" name="prateleira" required class="mt-1 w-full p-2 border rounded"></select>
                        </div>
                    </div>
                    <div class="flex justify-end pt-4 border-t">
                        <button type="submit" id="registrarBtn" class="bg-indigo-600 text-white px-6 py-3 rounded">Registrar Entrada</button>
                    </div>
                </div>
            </form>
            <div id="successMessage" class="hidden mt-4 p-4 bg-green-100 text-green-700 rounded"></div>
            <div id="errorMessage" class="hidden mt-4 p-4 bg-red-100 text-red-700 rounded"></div>
        </div>
    </div>
    <script src="/js/recebimento.js"></script>
</body>
</html>