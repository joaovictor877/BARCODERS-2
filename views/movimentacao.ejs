<!-- views/movimentacao.ejs -->
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <title>Movimentação de Material</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Verificação de autenticação removida (backend handle) -->
    <script type="text/javascript" src="https://unpkg.com/@zxing/library@latest"></script>
    <link rel="stylesheet" href="/css/movimentacao.css"> <!-- CSS para os passos -->
</head>

<body class="bg-gray-100">
    <div class="container mx-auto px-6 py-12">
        <a href="/lobby" class="text-indigo-600">&larr; Voltar ao Lobby</a>
        <h1 class="text-4xl font-bold mb-8">Assistente de Movimentação</h1>

        <div class="bg-white p-8 rounded shadow-md max-w-2xl mx-auto">

            <!-- Passo 1: Escanear Máquina -->
            <div id="passo-1-maquina" class="passo">
                <h2 class="passo-titulo">Passo 1: Escanear a Máquina de Destino</h2>
                <div id="scanner-container-maquina"></div>
                <button id="iniciar-scanner-maquina" class="btn-scanner">Usar Câmera</button>

                <!-- Opção Manual -->
                <div class="mt-4 border-t pt-4">
                    <p class="text-sm text-gray-600 mb-2">Ou digite o código manualmente:</p>
                    <div class="flex gap-2">
                        <input type="text" id="input-manual-maquina" class="w-full p-2 border rounded"
                            placeholder="ID da Máquina">
                        <button id="btn-manual-maquina"
                            class="bg-gray-700 text-white px-4 py-2 rounded hover:bg-gray-800">OK</button>
                    </div>
                </div>
            </div>

            <!-- Passo 2: Selecionar Material -->
            <div id="passo-2-material" class="passo hidden">
                <h2 class="passo-titulo">Passo 2: Selecionar Material Compatível</h2>
                <p class="mb-4">Máquina: <strong id="info-maquina"></strong></p>
                <div id="lista-materiais" class="space-y-2"></div>
            </div>

            <!-- Passo 3: Buscar e Escanear Material -->
            <div id="passo-3-buscar" class="passo hidden">
                <h2 class="passo-titulo">Passo 3: Buscar e Escanear o Material</h2>
                <div class="info-box">
                    <p>Vá até o local indicado e escaneie o código de barras do lote.</p>
                    <p><strong>Material:</strong> <span id="info-material-tipo"></span></p>
                    <p><strong>Local:</strong> <span id="info-localizacao"></span></p>
                </div>
                <div id="scanner-container-material"></div>
                <button id="iniciar-scanner-material" class="btn-scanner">Usar Câmera</button>

                <!-- Opção Manual -->
                <div class="mt-4 border-t pt-4">
                    <p class="text-sm text-gray-600 mb-2">Ou digite o código manualmente:</p>
                    <div class="flex gap-2">
                        <input type="text" id="input-manual-material" class="w-full p-2 border rounded"
                            placeholder="Código do Lote">
                        <button id="btn-manual-material"
                            class="bg-gray-700 text-white px-4 py-2 rounded hover:bg-gray-800">OK</button>
                    </div>
                </div>
            </div>
            <!-- Passo 3.5: Definir Quantidade -->
            <div id="passo-3-quantidade" class="passo hidden">
                <h2 class="passo-titulo">Passo 3.5: Definir Quantidade</h2>
                <div class="info-box">
                    <p>Material confirmado! Informe a quantidade a ser movida.</p>
                </div>
                <div class="flex gap-2">
                    <input type="number" id="input-quantidade" class="w-full p-3 border rounded text-lg" min="1"
                        value="1" placeholder="Qtd">
                    <button id="btn-confirmar-quantidade"
                        class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-indigo-700">Confirmar</button>
                </div>
            </div>

            <!-- Passo 4: Confirmar Máquina -->
            <div id="passo-4-confirmar" class="passo hidden">
                <h2 class="passo-titulo">Passo 4: Confirmar a Máquina de Destino</h2>
                <p class="info-box">Para finalizar, escaneie novamente o código da máquina de destino.</p>
                <div id="scanner-container-confirmacao"></div>
                <button id="iniciar-scanner-confirmacao" class="btn-scanner">Usar Câmera</button>

                <!-- Opção Manual -->
                <div class="mt-4 border-t pt-4">
                    <p class="text-sm text-gray-600 mb-2">Ou digite o código manualmente:</p>
                    <div class="flex gap-2">
                        <input type="text" id="input-manual-confirmacao" class="w-full p-2 border rounded"
                            placeholder="ID da Máquina">
                        <button id="btn-manual-confirmacao"
                            class="bg-gray-700 text-white px-4 py-2 rounded hover:bg-gray-800">OK</button>
                    </div>
                </div>
            </div>

            <!-- Mensagens de Feedback -->
            <div id="mensagem-sucesso" class="feedback-sucesso hidden"></div>
            <div id="mensagem-erro" class="feedback-erro hidden"></div>
        </div>
    </div>
    <script src="/js/movimentacao.js?v=2"></script>
</body>

</html>